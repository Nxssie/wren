<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The in-app updater hands a downloaded APK to the system installer, which is itself
         enough to publish a package; Android additionally requires the user to allow
         "install unknown apps" for Wren, which ApkInstaller detects before offering Install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".WrenApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Wren"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wren">
        <!-- singleTop: a widget tap while Wren is alive must reach the running instance
             (onNewIntent) instead of stacking a second one that back-press would finish. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The package installer is another process and cannot read our private cache, so the
             downloaded APK is shared as a content:// URI instead of a file path. exported=false:
             only the one-off URI grant below reaches the file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The captcha SoundCloud's bot protection puts in front of a like; see DataDomeChallenge. -->
        <activity
            android:name=".util.DataDomeChallengeActivity"
            android:exported="false"
            android:label="SoundCloud check" />

        <service
            android:name=".playback.WrenPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Home-screen playback widget. exported=false: the system delivers APPWIDGET_UPDATE
             to the component directly, so nothing else needs to reach the receiver. -->
        <receiver
            android:name=".widget.WrenWidgetReceiver"
            android:exported="false"
            android:label="@string/wren_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wren_widget_info" />
        </receiver>
    </application>
</manifest>
